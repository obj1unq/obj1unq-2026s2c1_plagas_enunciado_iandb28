import plagas.*
import elementos.*
describe "Test de elementos" {
  const barrio = new Barrio()

  test "Un hogar es favorable para la vida humana" {
    const hogarBueno = new Hogar(mugre = 4, confort = 8)
    assert.that(hogarBueno.esFavorable())
  }

  test "Un hogar no es favorable para la vida humana" {
    const hogarMalo = new Hogar(mugre = 5, confort = 8)
    assert.notThat(hogarMalo.esFavorable())
  }

  test "Una huerta es favorable para la vida humana" {
    const huertaBuena = new Huerta(capacidadDeProduccion = 150)
    assert.that(huertaBuena.esFavorable())
  }

  test "Una huerta no es favorable para la vida humana" {
    const huertaMala = new Huerta(capacidadDeProduccion = 50)
    assert.notThat(huertaMala.esFavorable())
  }

  test "El nivel de producción no es fijo" {
    const huertaBuena = new Huerta(capacidadDeProduccion = 150)
    nivelDeProduccionDeHuertas.nivel(200)
    assert.notThat(huertaBuena.esFavorable())
  }

  test "Cambiar el nivel de producción afecta a todas las huertas" {
    const huertaMala = new Huerta(capacidadDeProduccion = 50)
    const huertaBuena = new Huerta(capacidadDeProduccion = 150)
    nivelDeProduccionDeHuertas.nivel(40)
    assert.that(huertaMala.esFavorable())
    assert.that(huertaBuena.esFavorable())
  }

  test "Una mascota es favorable para la vida humana" {
    const mascotaBuena = new Mascota(nivelDeSalud = 300)
    assert.that(mascotaBuena.esFavorable())
  }

  test "Una mascota no es favorable para la vida humana" {
    const mascotaMala = new Mascota(nivelDeSalud = 200)
    assert.notThat(mascotaMala.esFavorable())
  }
  

  test "Un barrio es copado" {
    barrio.agregarElemento(new Hogar(mugre = 4, confort = 8))
    barrio.agregarElemento(new Huerta(capacidadDeProduccion = 150))
    barrio.agregarElemento(new Mascota(nivelDeSalud = 200))
    assert.that(barrio.esCopado())
  }

  test "Un barrio no es copado" {
    barrio.agregarElemento(new Hogar(mugre = 4, confort = 8))
    barrio.agregarElemento(new Huerta(capacidadDeProduccion = 50))
    barrio.agregarElemento(new Mascota(nivelDeSalud = 200))
    assert.notThat(barrio.esCopado())
  }

}

describe "Test de plagas" {
  test "El nivel de daño de una plaga de cucarachas es la mitad de su poblacion" {
    const plagaDe30Cucarachas = new PlagaDeCucarachas(poblacion = 30, pesoPromedio = 8)
    assert.equals(15, plagaDe30Cucarachas.nivelDeDaño())
  }

  test "Una plaga de cucarachas no transmite enfermedades si su peso promedio es menor a 10" {
    const plagaDe25Cucarachas = new PlagaDeCucarachas(poblacion = 25, pesoPromedio = 9)
    assert.notThat(plagaDe25Cucarachas.transmiteEnfermedades())
  }

  test "Una plaga de cucarachas transmite enfermedades si su peso promedio es igual o mayor a 10" {
    const plagaDe35Cucarachas = new PlagaDeCucarachas(poblacion = 35, pesoPromedio = 10)
    assert.that(plagaDe35Cucarachas.transmiteEnfermedades())
  }

  test "Una plaga de cucarachas tiene que tener una población mayor o igual a 10 para transmitir enfermedades incluso si cumple con el peso promedio" {
    const plagaDe5Cucarachas = new PlagaDeCucarachas(poblacion = 5, pesoPromedio = 11)
    assert.notThat(plagaDe5Cucarachas.transmiteEnfermedades())
  }

  test "El nivel de daño de una plaga de pulgas es el doble de su poblacion" {
    const plagaDe30Pulgas = new PlagaDePulgas(poblacion = 30)
    assert.equals(60, plagaDe30Pulgas.nivelDeDaño())
  }

  test "Una plaga de pulgas no transmite enfermedades si su población es menor a 10" {
    const plagaDe5Pulgas = new PlagaDePulgas(poblacion = 5)
    assert.notThat(plagaDe5Pulgas.transmiteEnfermedades())
  }

  test "Una plaga de pulgas transmite enfermedades si su población es igual o mayor a 10" {
    const plagaDe35Pulgas = new PlagaDePulgas(poblacion = 35)
    assert.that(plagaDe35Pulgas.transmiteEnfermedades())
  }

    test "El nivel de daño de una plaga de garrapatas es el doble de su poblacion" {
    const plagaDe30Garrapatas = new PlagaDeGarrapatas(poblacion = 30)
    assert.equals(60, plagaDe30Garrapatas.nivelDeDaño())
  }

  test "Una plaga de garrapatas no transmite enfermedades si su población es menor a 10" {
    const plagaDe5Garrapatas = new PlagaDeGarrapatas(poblacion = 5)
    assert.notThat(plagaDe5Garrapatas.transmiteEnfermedades())
  }

  test "Una plaga de garrapatas transmite enfermedades si su población es igual o mayor a 10" {
    const plagaDe35Garrapatas = new PlagaDeGarrapatas(poblacion = 35)
    assert.that(plagaDe35Garrapatas.transmiteEnfermedades())
  }

    test "El nivel de daño de una plaga de mosquitos es el mismo que su poblacion" {
    const plagaDe30Mosquitos = new PlagaDeMosquitos(poblacion = 30)
    assert.equals(30, plagaDe30Mosquitos.nivelDeDaño())
  }

  test "Una plaga de mosquitos no transmite enfermedades si su población no es múltiplo de 3" {
    const plagaDe25Mosquitos = new PlagaDeMosquitos(poblacion = 25)
    assert.notThat(plagaDe25Mosquitos.transmiteEnfermedades())
  }

  test "Una plaga de mosquitos transmite enfermedades si su población es múltiplo de 3" {
    const plagaDe15Mosquitos = new PlagaDeMosquitos(poblacion = 15)
    assert.that(plagaDe15Mosquitos.transmiteEnfermedades())
  }

  test "Una plaga de mosquitos tiene que tener una población mayor o igual a 10 para transmitir enfermedades incluso si cumple con que sea múltiplo de 3" {
    const plagaDe9Mosquitos = new PlagaDeMosquitos(poblacion = 9)
    assert.notThat(plagaDe9Mosquitos.transmiteEnfermedades())
  }
}

describe "Test de efectos de elementos al recibir ataque" {
  const plagaSinEnfermedades = new PlagaDePulgas(poblacion = 5) // nivel de daño: 10
  const plagaConEnfermedades = new PlagaDePulgas(poblacion = 15) // nivel de daño: 30
  
  test "Un hogar aumenta su mugre en la misma cantidad del nivel de daño de la plaga atacante" {
    const hogar = new Hogar(mugre = 4, confort = 8)
    hogar.recibeAtaqueDe(plagaSinEnfermedades)
    assert.equals(14, hogar.mugre())
  }

  test "Una huerta baja su capacidad de producción en un 10% del nivel de daño de la plaga atacante que no transmite enfermedades" {
    const huerta = new Huerta(capacidadDeProduccion = 20)
    huerta.recibeAtaqueDe(plagaSinEnfermedades)
    assert.equals(19, huerta.capacidadDeProduccion())
  }

  test "Una huerta baja su capacidad de producción en 10 puntos y un 10% del nivel de daño de la plaga atacante que transmite enfermedades" {
    const huertaGrande = new Huerta(capacidadDeProduccion = 50)
    huertaGrande.recibeAtaqueDe(plagaConEnfermedades)
    assert.equals(37, huertaGrande.capacidadDeProduccion())
  }

  test "Una mascota baja su nivel de salud en la misma cantidad del nivel de daño de la plaga atacante que transmite enfermedades" {
    const mascota = new Mascota(nivelDeSalud = 35)
    mascota.recibeAtaqueDe(plagaConEnfermedades)
    assert.equals(5, mascota.nivelDeSalud())
  }

  test "Una mascota no recibe cambios si la la plaga atacante no transmite enfermedades" {
    const mascotaSaludable = new Mascota(nivelDeSalud = 40)
    mascotaSaludable.recibeAtaqueDe(plagaSinEnfermedades)
    assert.equals(40, mascotaSaludable.nivelDeSalud())
  }
}

describe "Test de efectos de plagas al atacar" {
  const hogarVictima = new Hogar(mugre = 4, confort = 8)
  test "Una plaga de pulgas aumenta su poblacion un 10% al atacar" {
    const plagaDePulgas = new PlagaDePulgas(poblacion = 20)
    plagaDePulgas.atacaA(hogarVictima)
    assert.equals(22, plagaDePulgas.poblacion())
  }

  test "Una plaga cambia al elemento que ataca" {
    const plagaDeMosquitos = new PlagaDeMosquitos(poblacion = 10)
    plagaDeMosquitos.atacaA(hogarVictima)
    assert.equals(15, hogarVictima.mugre()) // el nivel de daño de la plaga es 10 pero aumenta un 10% al momento de atacar, es decir queda en 11
  }

  test "Una plaga de cucarachas aumenta su poblacion un 10% y su peso promedio en 2 gramos al atacar" {
    const plagaDeCucarachas = new PlagaDeCucarachas(poblacion = 20, pesoPromedio = 5)
    plagaDeCucarachas.atacaA(hogarVictima)
    assert.equals(22, plagaDeCucarachas.poblacion())
    assert.equals(7, plagaDeCucarachas.pesoPromedio())
  }

  test "Una plaga de garrapatas aumenta su poblacion un 20% al atacar" {
    const plagaDeGarrapatas = new PlagaDeGarrapatas(poblacion = 20)
    plagaDeGarrapatas.atacaA(hogarVictima)
    assert.equals(24, plagaDeGarrapatas.poblacion())
  }
}